<?xml version="1.0"?>
<!-- Only logged-in users with the Student role may open pages in this folder.
     Guests are redirected to the login page; other roles are refused. -->
<configuration>
  <system.web>
    <authorization>
      <allow roles="Student" />
      <deny users="*" />
    </authorization>
    <!-- Assignment uploads may be up to 10 MB; the request limit (in KB) is set a little
         higher so the page itself can show a friendly message for files between 10 and 12 MB. -->
    <httpRuntime maxRequestLength="12288" executionTimeout="120" />
  </system.web>
</configuration>
