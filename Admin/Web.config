<?xml version="1.0"?>
<!-- Only logged-in users with the Admin role may open pages in this folder.
     Guests are redirected to the login page; students are refused. -->
<configuration>
  <system.web>
    <authorization>
      <allow roles="Admin" />
      <deny users="*" />
    </authorization>
    <!-- Admins may upload lecture videos (up to 40 MB). ASP.NET's request limit (KB) is a little
         higher than that, so the page can show a friendly message for files just over the limit. -->
    <httpRuntime maxRequestLength="43008" executionTimeout="300" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- IIS's own limit (bytes, 64 MB) must be HIGHER than ASP.NET's: if IIS refused first, the
             user would get a bare "413" error instead of our friendly "file too large" message. -->
        <requestLimits maxAllowedContentLength="67108864" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
