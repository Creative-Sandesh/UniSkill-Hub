<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the secret settings. HOW TO USE:
    1. Copy this file and name the copy  Secrets.config  (same folder as Web.config).
    2. Get a free key at https://aistudio.google.com/apikey and paste it below.
    3. Save. Reload a PDF resource page: the "Summarize with AI" button appears (no restart needed).

  The file must keep exactly this shape (an <appSettings> element with <add key=... value=... /> lines). An empty or
  broken file is ignored: the site still works, but the button stays hidden and a note is written to App_Data/Logs.

  Secrets.config is listed in .gitignore, so your key is never committed. Never put the key in Web.config.
  ASP.NET refuses to serve any *.config file to a browser.
-->
<appSettings>
  <add key="MistralApiKey" value="" />
</appSettings>

