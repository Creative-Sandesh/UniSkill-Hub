<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the secret settings. HOW TO USE:
    1. Copy this file and name the copy  Secrets.config  (same folder as Web.config).
    2. Get a free key at https://aistudio.google.com/apikey and paste it below.
    3. Save, then RESTART the site (in Visual Studio: stop and run again). After that the "Summarize with AI"
       button appears on PDF/TXT resources. (Changing the key later restarts the site by itself.)

  Secrets.config is listed in .gitignore, so your key is never committed. Never put the key in Web.config.
  ASP.NET refuses to serve any *.config file to a browser.
-->
<appSettings>
  <add key="GeminiApiKey" value="" />
</appSettings>

