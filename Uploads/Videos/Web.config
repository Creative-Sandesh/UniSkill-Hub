<?xml version="1.0"?>
<!-- This folder is public (the HTML5 players read it directly), so only media file types can be requested here.
     Anything else - for example a script that somehow got uploaded - is refused by IIS. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false">
          <clear />
          <add fileExtension=".webm" allowed="true" />
          <add fileExtension=".mp4" allowed="true" />
          <add fileExtension=".ogv" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
